# package-lock.json is deliberately TRACKED (was ignored until 2026-08-16). Without it
# every CI run re-resolved dependency versions, so a compromised patch release of any
# transitive dep would land in a build silently and unreviewably. CI now uses `npm ci`,
# which requires the lockfile and installs exactly what it pins.
/TMDB_NEW/
/temp/
/runtime/backend.env
/runtime/.env.local
/runtime/.env.production
/runtime/rsa-private.key
/runtime/rsa-public.key
/.postman/

### Server config — kept in private repo (db-world-config) ###
/server_config/

