# Frontend environment variables — copy to .env.local / .env.production and fill in real values
# DO NOT commit .env.local or .env.production to git

# Base URL of the backend API.
# - Leave blank in dev if you proxy /api via Vite to a local backend.
# - Set to the API host in staging/prod, e.g. https://api.db-world.in
# - When unset, the app falls back to api.<frontend-host> for the known
#   production frontend domain, so prod still works without this var.
VITE_API_BASE_URL=https://api.db-world.in

# --- AdSense display units -----------------------------------------------------
# The 10-digit data-ad-slot of each unit, from AdSense > Ads > By ad unit >
# Display ads. Nothing secret: these ship in the client bundle, as does the
# publisher id in index.html and public/ads.txt.
#
# One unit PER PAGE, so reporting can show which surface actually earns rather
# than averaging them into a number you cannot act on. Names say WHERE a unit
# sits, never a size or a position within the page.
#
# Leave a value EMPTY and that placement renders nothing, which is what makes the
# site safe to deploy before a unit exists or before the account is approved.
VITE_AD_SLOT_HOME=
VITE_AD_SLOT_CINEMA_BROWSE=
VITE_AD_SLOT_CINEMA_MOVIES=
VITE_AD_SLOT_CINEMA_SERIES=
VITE_AD_SLOT_CINEMA_DETAIL=
VITE_AD_SLOT_IPO_LIST=
VITE_AD_SLOT_IPO_DETAIL=
