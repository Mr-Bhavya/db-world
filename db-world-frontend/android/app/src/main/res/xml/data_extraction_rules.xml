<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ counterpart to allowBackup="false" / fullBackupContent="false".
  This app holds an offline encrypted document vault, AndroidKeyStore-backed vault
  keys, biometric device tokens and JWT refresh state, so its private data must not
  leave the device via cloud backup or device-to-device transfer. Excluding
  everything is deliberate: there is nothing here worth restoring, and a restored
  copy on another device would carry credentials with it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
