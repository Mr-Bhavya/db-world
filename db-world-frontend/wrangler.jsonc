{
  // Editor autocomplete/validation (resolves after `npm i -D wrangler`)
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Worker name shown in the Cloudflare dashboard
  "name": "frontend",

  // Pins Workers runtime behaviour; leave as-is, bump only on purpose
  "compatibility_date": "2026-11-14",

  // Worker entry point. It handles crawler rendering, the live sitemap, and redirects
  // before falling back to the Vite assets. No secrets are required.
  "main": "./worker.js",

  "assets": {
    // Vite build output, relative to this file
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,

    // Unknown paths still return index.html so React Router handles the client route.
    "not_found_handling": "single-page-application"
  },

  // Serve on your own domain; Cloudflare creates the DNS record and certificate
  "routes": [
    { "pattern": "db-world.in", "custom_domain": true },
    { "pattern": "www.db-world.in", "custom_domain": true }
  ],

  // Don't also expose the site on *.workers.dev or per-version preview URLs
  "workers_dev": false,
  "preview_urls": false
}
